# OWNIT environment configuration
# Copy to .env and adjust for your machine.

# SQLite database file (local dev). Swap the provider/datasource for Postgres in production.
DATABASE_URL="file:./dev.db"

# Base URL used for canonical URLs, sitemap, emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Payments ----
# Payment provider: "mock" (built-in test flow) | "razorpay" | "stripe"
PAYMENT_PROVIDER="mock"
# Secret used to sign mock payment confirmations and webhooks
PAYMENT_WEBHOOK_SECRET="change-me"
RZP_KEY_ID=""
RZP_KEY_SECRET=""
STRIPE_SECRET_KEY=""

# ---- Email ----
# Transactional email provider: "console" (logs to server console) | "resend"
EMAIL_PROVIDER="console"
EMAIL_FROM="OWNIT <hello@ownit.example>"

# ---- Admin bootstrap (used by the seed script) ----
ADMIN_EMAIL="admin@ownit.test"
ADMIN_PASSWORD="change-me"

# ---- Uploads ----
MAX_UPLOAD_MB="8"
